---
import ShippedCarousel from '@/component/ShippedCarousel'
import {
  getHomepageShipped,
  getShippedVisual,
  type ShippedSlide,
} from '@/lib/shipped'

const entries = await getHomepageShipped()
const headingId = 'last-shipped'
const slides: ShippedSlide[] = entries.map(entry => ({
  example: entry.data.example,
  href: entry.data.href,
  slug: entry.data.slug,
  title: entry.data.title,
  visual: getShippedVisual(entry.data),
  writeup: entry.body.trim(),
}))
---

{
  slides.length > 0 && (
    <section class="home-section last-shipped" aria-labelledby={headingId}>
      <div class="home-section__head last-shipped__head">
        <h2 id={headingId}>Last shipped</h2>
        <a class="last-shipped__all" href="/shipped">
          All shipped →
        </a>
      </div>
      <ShippedCarousel client:load slides={slides} />
    </section>
  )
}

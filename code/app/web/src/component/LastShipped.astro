---
import ShippedCard from '@/component/ShippedCard.astro'
import { formatDate, formatRelativeTime, toISODate } from '@/lib/date'
import { getLatestShipped } from '@/lib/shipped'

const entry = await getLatestShipped()
const headingId = 'last-shipped'
---

{
  entry && (
    <section class="home-section last-shipped" aria-labelledby={headingId}>
      <div class="last-shipped__eyebrow">
        <h2 id={headingId}>Last shipped</h2>
        <span class="last-shipped__sep" aria-hidden="true">
          ·
        </span>
        <time
          datetime={toISODate(entry.data.shippedAt)}
          title={formatDate(entry.data.shippedAt)}
        >
          {formatRelativeTime(entry.data.shippedAt)}
        </time>
      </div>
      <ShippedCard entry={entry} />
    </section>
  )
}

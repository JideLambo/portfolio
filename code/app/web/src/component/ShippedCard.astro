---
import { getShippedVisual } from '@/lib/shipped'
import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'

type Props = {
  entry: CollectionEntry<'shipped'>
}

const { entry } = Astro.props
const { Content } = await render(entry)
const visual = getShippedVisual(entry.data)
---

<article class="shipped-card">
  <div class="shipped-card__visual">
    {
      visual ? (
        <img
          src={visual}
          alt=""
          width="320"
          height="320"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="shipped-card__placeholder" aria-hidden="true" />
      )
    }
  </div>
  <div class="shipped-card__copy">
    <h2 class="shipped-card__title">{entry.data.title}</h2>
    <div class="shipped-card__writeup">
      <Content />
    </div>
    {
      entry.data.href && (
        <p class="shipped-card__actions">
          <a
            href={entry.data.href}
            rel="noopener noreferrer"
            target="_blank"
          >
            View →<span class="visually-hidden"> (opens in new tab)</span>
          </a>
        </p>
      )
    }
  </div>
</article>

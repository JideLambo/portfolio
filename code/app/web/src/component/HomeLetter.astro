---
import {
  firstDistroUrl,
  sinchUrl,
  useLayUrl,
  wonderstandUrl,
} from '@shared/lib/site'

const products = [
  {
    href: wonderstandUrl,
    label: 'Wonderstand',
    logo: '/brands/wonderstand.svg',
    blurb: 'AI assistants in iMessage for vertical businesses',
  },
  {
    href: firstDistroUrl,
    label: 'FirstDistro',
    logo: '/brands/firstdistro.svg',
    blurb: 'account and revenue intelligence',
  },
  {
    href: useLayUrl,
    label: 'UseLay',
    logo: '/brands/uselay.svg',
    blurb: 'in-app feedback that pins comments to your UI',
  },
] as const
---

<section class="home-letter" aria-label="Introduction">
  <h1 class="visually-hidden">I'm Jide</h1>
  <p>
    I'm Jide, and I built{' '}
    {
      products.map((product, index) => (
        <>
          {index === products.length - 1 ? ' and ' : index > 0 ? ', ' : null}
          <a
            class="home-letter__product"
            href={product.href}
            rel="noopener noreferrer"
            target="_blank"
          >
            <img
              class="home-letter__logo"
              src={product.logo}
              alt=""
              width="16"
              height="16"
              decoding="async"
            />
            {product.label}
            <span class="visually-hidden"> (opens in new tab)</span>
          </a>
          {' '}
          ({product.blurb})
        </>
      ))
    }. I'm also working at{' '}
    <a
      class="home-letter__product"
      href={sinchUrl}
      rel="noopener noreferrer"
      target="_blank"
    >
      <img
        class="home-letter__logo"
        src="/brands/sinch.png"
        alt=""
        width="16"
        height="16"
        decoding="async"
      />
      Sinch
      <span class="visually-hidden"> (opens in new tab)</span>
    </a>, building an intelligent inbox.
  </p>
</section>

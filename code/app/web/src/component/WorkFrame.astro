---
import type { WorkFrame } from '@/lib/work'

type Props = {
  class?: string
  frame: WorkFrame
  loading?: 'eager' | 'lazy'
  step?: string
}

const { class: className, frame, loading = 'lazy', step } = Astro.props
---

<figure class:list={['work-frame', 'work-frame--focus', className]}>
  {
    step && (
      <p class="work-frame__step">{step}</p>
    )
  }
  <img
    class="work-frame__img"
    src={frame.src}
    alt={frame.alt}
    width={frame.width}
    height={frame.height}
    loading={loading}
    decoding="async"
  />
  {
    frame.caption && (
      <figcaption class="work-frame__caption">{frame.caption}</figcaption>
    )
  }
  {
    frame.callouts && frame.callouts.length > 0 && (
      <ul class="work-frame__callouts">
        {frame.callouts.map(callout => (
          <li>{callout}</li>
        ))}
      </ul>
    )
  }
</figure>

---
import Layout from '@/layout/Layout.astro'
import { aboutLead } from '@shared/lib/site'
---

<Layout title="About" description={aboutLead}>
  <div class="wrap">
    <header class="hero about-hero">
      <img
        class="about-hero__photo"
        src="/jide.jpg"
        alt="Jide Lambo"
        width="400"
        height="400"
        decoding="async"
      />
      <div class="about-hero__copy">
        <h1>Hi, I'm Jide</h1>
        <p class="lead hero__lead">{aboutLead}</p>
      </div>
    </header>

    <section class="home-section" aria-labelledby="recent">
      <div class="home-section__head">
        <h2 id="recent">Recent</h2>
      </div>
      <ul class="about-chat">
        <li>
          I am building{' '}
          <a
            href="https://firstdistro.com"
            rel="noopener noreferrer"
            target="_blank"
          >
            FirstDistro
            <span class="visually-hidden"> (opens in new tab)</span>
          </a>
          , account intelligence that catches silent churn and proves the
          revenue you kept.
        </li>
        <li>
          I also built{' '}
          <a
            href="https://uselay.com"
            rel="noopener noreferrer"
            target="_blank"
          >
            UseLay
            <span class="visually-hidden"> (opens in new tab)</span>
          </a>
          , in-app feedback that lets users point at what's broken instead of
          describing it.
        </li>
        <li>
          I am a Senior Product Designer at{' '}
          <a
            href="https://sinch.com"
            rel="noopener noreferrer"
            target="_blank"
          >
            Sinch
            <span class="visually-hidden"> (opens in new tab)</span>
          </a>
          , working on intelligent inbox and AI messaging at scale for businesses.
        </li>
      </ul>
    </section>

    <section class="home-section" aria-labelledby="career">
      <div class="home-section__head">
        <h2 id="career">Career</h2>
      </div>
      <ul class="about-chat">
        <li>
          I created Wonderstand, conversational and AI companion experiments.
          The product is shut down.
        </li>
        <li>
          I created TokiApp, personal AI assistants for everyone. Also shut
          down.
        </li>
        <li>
          At{' '}
          <a
            href="https://nordcloud.com"
            rel="noopener noreferrer"
            target="_blank"
          >
            Nordcloud
            <span class="visually-hidden"> (opens in new tab)</span>
          </a>
          {' '}(an IBM company), I was lead designer on the BMW Public Cloud
          Platform.
        </li>
        <li>
          At{' '}
          <a
            href="https://bcaster.com"
            rel="noopener noreferrer"
            target="_blank"
          >
            BCaster
            <span class="visually-hidden"> (opens in new tab)</span>
          </a>
          , I was founding design engineer on an AI user-generated content platform.
        </li>
        <li>
          At{' '}
          <a
            href="https://www.gtbank.com"
            rel="noopener noreferrer"
            target="_blank"
          >
            GTBank
            <span class="visually-hidden"> (opens in new tab)</span>
          </a>
          , I was lead software product designer on the GTWorld app.
        </li>
      </ul>
    </section>
  </div>
</Layout>

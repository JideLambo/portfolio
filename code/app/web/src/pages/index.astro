---
import PostList from '@/component/PostList.astro'
import Layout from '@/layout/Layout.astro'
import { getHomepageWriting } from '@/lib/post'
import { siteAuthor, siteTagline } from '@shared/lib/site'

const { latestPosts } = await getHomepageWriting()
---

<Layout>
  <div class="wrap">
    <section class="hero">
      <h1>{siteAuthor}</h1>
      <p class="lead hero__lead">{siteTagline}</p>
      <p class="hero__cta">
        <a class="text-link" href="/about">About →</a>
        <a class="text-link" href="/writing">Writing →</a>
      </p>
    </section>

    {
      latestPosts.length > 0 && (
        <section class="home-section">
          <div class="home-section__head">
            <h2>Latest writing</h2>
            <a class="text-link" href="/writing">
              All writing →
            </a>
          </div>
          <PostList posts={latestPosts} />
        </section>
      )
    }
  </div>
</Layout>

---
import { getSocialLink } from '@shared/lib/site'
import Contributions from '@/component/Contributions.astro'
import HomeLetter from '@/component/HomeLetter.astro'
import LastShipped from '@/component/LastShipped.astro'
import PostList from '@/component/PostList.astro'
import WorkshopStage from '@/component/WorkshopStage'
import Layout from '@/layout/Layout.astro'
import {
  fetchContributionCalendar,
  githubLoginFromHref,
} from '@/lib/github-contributions'
import { getHomepageWriting } from '@/lib/post'

const { latestPosts } = await getHomepageWriting()
const githubLogin = githubLoginFromHref(getSocialLink('GitHub').href)
const contributions = githubLogin
  ? await fetchContributionCalendar(githubLogin)
  : null
---

<Layout>
  <div class="wrap">
    <div class="home-hero">
      <HomeLetter />
      <WorkshopStage client:load />
    </div>

    <LastShipped />

    {
      latestPosts.length > 0 && (
        <section class="home-section">
          <div class="home-section__head">
            <h2>Latest writing</h2>
            <a class="home-section__all" href="/writing">
              All writing →
            </a>
          </div>
          <PostList posts={latestPosts} />
        </section>
      )
    }

    {contributions && <Contributions calendar={contributions} />}
  </div>
</Layout>

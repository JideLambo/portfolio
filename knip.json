{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    "react-compiler-runtime"
  ],
  "ignoreExportsUsedInFile": true,
  "treatConfigHintsAsErrors": false,
  "workspaces": {
    "code/app/shared": {
      "entry": ["src/lib/**/*.ts", "!src/lib/**/*.test.ts"],
      "paths": {
        "@shared/*": ["./src/*"]
      },
      "project": ["src/**/*.ts"],
      "vitest": {
        "config": ["vitest.config.js"]
      }
    },
    "code/app/web": {
      "entry": [
        "src/pages/**/*.{astro,ts}",
        "src/layout/**/*.astro",
        "script/**/*.ts"
      ],
      "ignore": ["src/test/stubs/**"],
      "paths": {
        "@/*": ["./src/*"],
        "@shared/*": ["../shared/src/*"]
      },
      "project": ["src/**/*.{ts,tsx,astro}", "script/**/*.ts"],
      "vite": {
        "config": ["astro.config.mjs", "vitest.config.js"]
      },
      "vitest": {
        "config": ["vitest.config.js"]
      }
    }
  }
}

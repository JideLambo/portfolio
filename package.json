{
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "knip": "6.27.0",
    "npm-check-updates": "22.2.9",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "name": "portfolio-monorepo",
  "overrides": {
    "@astrojs/react": {
      "@vitejs/plugin-react": "6.0.3"
    },
    "vite": "8.1.3"
  },
  "private": true,
  "scripts": {
    "bump-deps": "ncu -u --removeRange --cooldown 5 --cwd code/app/shared && ncu -u --removeRange --cooldown 5 --cwd code/app/web && ncu -u --removeRange --cooldown 5",
    "clean": "npm run clean --workspaces --if-present",
    "dev": "npm run dev:web",
    "dev:web": "npm run dev:web -w web",
    "fix": "npm run fix --workspaces --if-present && npm run knip",
    "fix:shared": "npm run fix -w shared && npm run knip",
    "fix:web": "npm run fix -w web && npm run knip",
    "knip": "knip",
    "lint": "npm run lint --workspaces --if-present",
    "lint:shared": "npm run lint -w shared",
    "lint:web": "npm run lint -w web",
    "rasterize": "npm run rasterize -w web --",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:shared": "vitest run --project shared",
    "test:web": "vitest run --project web"
  },
  "type": "module",
  "workspaces": [
    "code/app/shared",
    "code/app/web"
  ]
}
